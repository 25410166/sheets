# CSheet desktop build environment variables
# Copy this to .env.local and fill in values for local development.
# NEVER commit .env.local or real values to version control.

# CookApps API base URL
# Production: https://cookapps.net
# Local:      http://localhost:3000
VITE_COOKAPPS_BASE_URL=http://localhost:3000

# CookApps Ed25519 lease public key (Base64 DER SPKI).
# This is the PUBLIC key for verifying offline leases issued by CookApps.
# The corresponding PRIVATE key lives ONLY on the CookApps server.
# Obtain this value from CookApps DevOps for each environment.
# NEVER set DESKTOP_LEASE_PRIVATE_KEY here.
VITE_DESKTOP_LEASE_PUBLIC_KEY_BASE64=MCowBQYDK2VwAyEAvSTxJ6EC0pASM2tyZYWRB7MZ7KTw/g3g03FwGPIh+EM=
