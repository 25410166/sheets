{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "CSheets",
  "version": "1.0.0",
  "identifier": "net.cookapps.csheet",
  "build": {
    "beforeDevCommand": "pnpm --filter @sheet/web dev",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CSheets",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "focus": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cookapps-csheet"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["xlsx", "xls", "ods", "csv"],
        "name": "Spreadsheet",
        "description": "CookApps Spreadsheet",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "sidebarImage": "icons/128x128.png"
      }
    }
  }
}
